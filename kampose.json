{
    "convention": "dotnet",
    "outputDirectory": ".site",
    "audit": {
        "options": [
            "recommended"
        ],
        "includeImplicitConstructors": true,
        "verifyExternalLinks": false,
        "stopOnIssues": true
    },
    "assemblies": [
        "src/bin/**/Kampute.DocToolkit.dll"
    ],
    "topics": [
        "docs/**/*.md"
    ],
    "assets": [
        {
            "source": [
                "LICENSE",
                "*.png",
                "docs/*.png"
            ]
        }
    ],
    "topicHierarchy": "directory",
    "theme": "classic",
    "themeSettings": {
        "projectName": "Kampute.DocToolkit",
        "projectSlogan": "A toolkit for generating custom .NET API documentation",
        "projectLogoLightUri": "logo-dark.png",
        "projectLogoDarkUri": "logo-light.png",
        "faviconUri": "ICON.png",
        "groupTypesByNamespace": true,
        "showTypeMembersSummary": true,
        "seeAlsoSubtopics": true,
        "menuItems": [
            "*"
        ],
        "pageFooter": [
            "- Copyright © {{now 'yyyy'}} Kampute",
            "- [MIT License](~/LICENSE)",
            "- [Source code](https://github.com/kampute/doc-toolkit)"
        ],
        "pageFooterRight": [
            "Built with [Kampose](https://kampute.github.io/kampose/)"
        ]
    }
}